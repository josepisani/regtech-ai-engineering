# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- Anthropic (Claude runtime calls) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Model + budget knobs (safe defaults)
CLAUDE_MODEL=claude-sonnet-5
MAX_TOKENS=1024

# --- Google Cloud (BigQuery, Cloud Run, later pgvector/Gemini) ---
# The project that holds your free-trial credit and billing.
GOOGLE_CLOUD_PROJECT=gen-lang-client-0987507894

# Optional: Gemini API key for embeddings (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
