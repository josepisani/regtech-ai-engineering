# Secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
gcp-key*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Notebooks / data scratch
.ipynb_checkpoints/
# data/ is ignored by default, but the Project 1 eval set is a versioned asset:
# it is synthetic, contains nothing confidential, and Week 3's numbers are
# meaningless without the exact descriptions and labels they were measured on.
# Note the `data/*` form: git cannot re-include a file whose parent directory is
# excluded, so `data/` plus a negation would silently not work.
data/*
!data/vendor_descriptions.jsonl
!data/labels.jsonl
# The labelling workbook travels too, so the ground-truth pass can be done
# on whichever machine you are sitting at. Synthetic data only.
*.sqlite
*.db

# OS / editor
.DS_Store
.idea/
.vscode/

# Local working copies and backups of third-party regulatory documents.
# Kept beside the repo for convenience; not part of the project and not ours
# to redistribute. Anything the project actually needs lives in data/.
/AI Act tool back up docs/

# Labelling workbook: superseded by data/labels.jsonl on 2026-09-10 (day3).
# Untracked, kept locally for reference.
/data/project1_labels.xlsx

# Model predictions on the labelled set: a dated snapshot per run, the Week 3
# before/after seed. Synthetic inputs, model outputs only.
!data/predictions.jsonl

# Deliverables downloaded from Claude, kept beside the repo for convenience.
# Not project files. Added 2026-09-10 after a briefing note for a lawyer -
# a document about personal data-protection exposure - was found sitting
# untracked at the repo root, one `git add -A` away from a public repo.
/Claude outputs/

# Showcase records referenced from the README: the four unseen worked examples
# and the self-check. Synthetic inputs, model outputs only. Added 2026-09-15 (day4).
!data/showcase/

.codex/

# Project 2 corpus (day6): public regulatory texts exactly as downloaded, so
# the chunker runs offline on either machine. chunks.jsonl is derived; rebuild
# it with `python -m toolkit.chunking`.
!data/corpus/
data/corpus/chunks.jsonl
